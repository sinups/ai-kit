{
  "name": "@sinups/ai-kit",
  "version": "0.2.0",
  "description": "Mantine UI kit for agent products: chat, tool calls, diff review, sessions, MCP, agents, skills, permissions, wizards and settings",
  "homepage": "https://github.com/sinups/ai-kit#readme",
  "packageManager": "yarn@4.0.1",
  "license": "MIT",
  "author": "Sinups",
  "keywords": [
    "mantine",
    "extension",
    "ai",
    "agent",
    "chat",
    "tool-calls",
    "streaming"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./styles/*": "./dist/styles/*"
  },
  "repository": "https://github.com/sinups/ai-kit.git",
  "peerDependencies": {
    "@mantine/core": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@tabler/icons-react": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "bugs": "https://github.com/sinups/ai-kit/issues",
  "dependencies": {
    "markdown-to-jsx": "^7.7.13"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
