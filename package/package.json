{
  "name": "@sinups/ai-kit",
  "version": "0.4.0",
  "description": "React UI kit for agent products on Mantine 9: agent chat with streaming Markdown, MCP tool call cards and approvals, composer, sessions, tasks, diff review and settings",
  "homepage": "https://sinups.github.io/ai-kit",
  "license": "MIT",
  "author": "Sinups",
  "keywords": [
    "react",
    "mantine",
    "ai",
    "chat",
    "agent",
    "mcp",
    "tool-calls",
    "streaming",
    "ai-sdk",
    "llm",
    "chat-ui",
    "ui-kit",
    "components"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinups/ai-kit.git",
    "directory": "package"
  },
  "peerDependencies": {
    "@mantine/core": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@tabler/icons-react": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "bugs": {
    "url": "https://github.com/sinups/ai-kit/issues"
  },
  "dependencies": {
    "markdown-to-jsx": "^7.7.13"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
