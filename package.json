{
  "name": "ai-kit-monorepo",
  "description": "Monorepo for @sinups/ai-kit: agent chat UI components for Mantine and their documentation site",
  "packageManager": "yarn@4.17.1",
  "private": true,
  "workspaces": [
    "package",
    "site"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sinups/ai-kit.git"
  },
  "scripts": {
    "clean": "rimraf package/dist",
    "build": "rollup -c rollup.config.mjs && tsx scripts/generate-dts && tsx scripts/prepare-css",
    "pack:preview": "yarn build && tsx scripts/pack-preview.ts",
    "size": "tsx scripts/check-size",
    "attw": "yarn dlx -q -p @arethetypeswrong/cli@0.18.5 attw --pack package --entrypoints .",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"{package,scripts,.storybook}/**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"{package,scripts,.storybook}/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit && yarn workspace ai-kit-site typecheck",
    "lint": "npm run oxlint && npm run stylelint",
    "oxlint": "oxlint -c oxlint.config.mjs .",
    "stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest",
    "check:examples": "tsx --tsconfig site/tsconfig.json scripts/check-example-sources",
    "test": "npm run syncpack && npm run format:test && npm run typecheck && npm run lint && npm run site:lint && npm run check:examples && npm run jest",
    "dev": "yarn workspace ai-kit-site dev",
    "storybook": "storybook dev -p 8271",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "storybook:serve": "http-server storybook-static -p 6106 -a 127.0.0.1 --silent",
    "test:storybook": "test-storybook --no-index-json --url ${STORYBOOK_URL:-http://127.0.0.1:8271}",
    "test:storybook:ci": "concurrently -k -s first -n serve,test \"yarn storybook:serve\" \"wait-on -t 60000 http-get://127.0.0.1:6106/index.json && STORYBOOK_URL=http://127.0.0.1:6106 yarn test:storybook --maxWorkers=2\"",
    "test:visual": "VISUAL=1 test-storybook --no-index-json --url ${STORYBOOK_URL:-http://127.0.0.1:8271}",
    "test:visual:ci": "concurrently -k -s first -n serve,test \"yarn storybook:serve\" \"wait-on -t 60000 http-get://127.0.0.1:6106/index.json && STORYBOOK_URL=http://127.0.0.1:6106 yarn test:visual --maxWorkers=2\"",
    "test:visual:baseline": "rimraf package/__visual__ storybook-visual-diff && VISUAL=update test-storybook --index-json --url ${STORYBOOK_URL:-http://127.0.0.1:8272} -u",
    "test:visual:baseline:ci": "concurrently -k -s first -n serve,baseline \"http-server storybook-static-base -p 6107 -a 127.0.0.1 --silent\" \"wait-on -t 60000 http-get://127.0.0.1:6107/index.json && STORYBOOK_URL=http://127.0.0.1:6107 yarn test:visual:baseline --maxWorkers=2\"",
    "syncpack": "syncpack list-mismatches",
    "syncpack:format": "syncpack format",
    "site:build": "yarn workspace ai-kit-site build",
    "site:lint": "yarn workspace ai-kit-site lint"
  },
  "devDependencies": {
    "@mantine-tests/core": "^2.0.0",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/test-runner": "^0.22.1",
    "@tabler/icons-react": "^3.40.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^29.5.14",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "^22.15.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/signale": "^1",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.0",
    "cssnano": "^5.1.15",
    "esbuild": "^0.25.5",
    "esbuild-jest": "^0.5.0",
    "fs-extra": "^11.3.0",
    "hash-css-selector": "^1.1.0",
    "http-server": "^14.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-image-snapshot": "^6.5.2",
    "markdown-to-jsx": "^7.7.13",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.4",
    "postcss-preset-mantine": "1.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rimraf": "^6.0.1",
    "rollup": "^4.41.1",
    "rollup-plugin-banner2": "^1.3.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "shiki": "^3.4.2",
    "signale": "^1.4.0",
    "storybook": "^8.6.14",
    "stylelint": "^16.20.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "syncpack": "^13.0.4",
    "tsx": "^4.19.4",
    "typescript": "6.0.2",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "zx": "^8.5.4"
  }
}
