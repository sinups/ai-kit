# How to reach the MCP server: stdio starts a command, http calls an endpoint.
MCP_TRANSPORT=stdio
MCP_SERVER_NAME=files

# stdio: the command that starts the server. The default is the official
# filesystem server, scoped to the sample folder shipped with this example.
# {dataDir} is replaced with the absolute path of that folder.
MCP_COMMAND=npx
MCP_ARGS=-y,@modelcontextprotocol/server-filesystem,{dataDir}

# http: the endpoint and, when the server needs one, credentials.
# Put the real values in .env.local, which is never committed.
MCP_URL=http://localhost:8091/mcp
MCP_TOKEN=
MCP_HEADERS=

# Model used by the Claude Agent SDK. Authentication comes from the CLI session
# already logged in on this machine, so no API key is needed here.
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TURNS=12

# Hosts allowed to reach the dev server from another origin, needed together
# with `yarn dev:lan`. A comma-separated list of hostnames or addresses, for
# example the LAN address of this machine. Network ranges are not accepted.
DEV_ORIGINS=
