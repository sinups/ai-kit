# Command that starts the MCP server over stdio. The default is the official
# filesystem server, scoped to the sample folder shipped with this example.
# {dataDir} is replaced with the absolute path of that folder.
MCP_SERVER_NAME=files
MCP_COMMAND=npx
MCP_ARGS=-y,@modelcontextprotocol/server-filesystem,{dataDir}

# Model used by the Claude Agent SDK. Authentication comes from the Claude Code
# session already logged in on this machine, so no API key is needed here.
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TURNS=12
