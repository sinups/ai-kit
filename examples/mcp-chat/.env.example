# MCP servers the agent talks to, as a JSON array. Each entry needs a name and
# either `url` (HTTP) or `command` with `args` (stdio). `token` is sent as a
# bearer header, `headers` adds anything else. `{dataDir}` in an argument is
# replaced with the absolute path of the sample folder of this example.
#
# The default below needs no credentials at all:
#   files     — the official filesystem server, scoped to ./data
#   context7  — up-to-date documentation and code examples for public libraries
#   deepwiki  — questions about a public GitHub repository and its wiki
#
# Two more public servers worth trying, neither needs a key:
#   fetch     — {"name":"fetch","command":"uvx","args":["mcp-server-fetch"]}
#               reads a URL and returns it as markdown
#   git       — {"name":"git","command":"uvx","args":["mcp-server-git","--repository","/path/to/repo"]}
#
# A server that needs a token goes in .env.local, never here:
#   {"name":"tracker","url":"https://mcp.example.com/mcp","token":"<token>"}
# A stdio server gets its secrets through `env`, never through `args`:
#   {"name":"github","command":"npx","args":["-y","@modelcontextprotocol/server-github"],"env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"<token>"}}
#
# The single-server keys of earlier versions (MCP_SERVER_NAME, MCP_TRANSPORT,
# MCP_URL, MCP_TOKEN, MCP_HEADERS, MCP_COMMAND, MCP_ARGS) still work: that
# server is added first, and MCP_SERVERS is appended to it.
MCP_SERVERS=[{"name":"files","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","{dataDir}"]},{"name":"context7","url":"https://mcp.context7.com/mcp"},{"name":"deepwiki","url":"https://mcp.deepwiki.com/mcp"}]

# Hosts allowed to reach the dev server from another origin, needed together
# with `yarn dev:lan`. A comma-separated list of hostnames or addresses, for
# example the LAN address of this machine. Network ranges are not accepted.
DEV_ORIGINS=

# Model used by the Claude Agent SDK. Authentication comes from the CLI session
# already logged in on this machine, so no API key is needed here.
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TURNS=30
